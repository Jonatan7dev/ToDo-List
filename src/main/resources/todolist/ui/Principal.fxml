<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="510" prefWidth="920" spacing="15" styleClass="page" stylesheets="@estilo.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="todolist.ui.MainController">
    <Label styleClass="kicker" text="ORGANIZADOR PERSONAL" />
    <Label styleClass="heading" text="Mis tareas" />
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button fx:id="newButton" styleClass="primary" text="+ Nuevo" onAction="#openNewTaskForm"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="clearCompletedButton" styleClass="secondary" text="Borrar todos los completados" onAction="#deleteAllCompleted"/>
    </HBox>
    <TableView fx:id="taskTable" fixedCellSize="54" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="350" text="Título" />
            <TableColumn fx:id="priorityColumn" prefWidth="125" text="Prioridad" />
            <TableColumn fx:id="completedColumn" prefWidth="145" text="Completada" />
            <TableColumn fx:id="actionsColumn" prefWidth="228" sortable="false" text="Acciones" />
        </columns>
        <placeholder><Label text="Crea tu primera tarea con el botón Nuevo." /></placeholder>
    </TableView>
</VBox>
